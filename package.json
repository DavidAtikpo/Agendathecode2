{
  "name": "agenda",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "register-staff": "node scripts/register-staff-for-organizer.mjs",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win",
    "electron:build:portable": "electron-builder --win portable",
    "postinstall": "prisma generate && prisma generate --schema=prisma/catalog-schema.prisma --config=prisma.config.catalog.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.2",
    "next": "16.2.2",
    "nodemailer": "^8.0.4",
    "openai": "^6.33.0",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.neurix.agenda",
    "productName": "Neurix Agenda",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "fr",
        "en"
      ]
    }
  }
}
